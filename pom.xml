<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>postulat</groupId>
    <artifactId>postulat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>postulat</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.3</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
        <picocli.version>4.7.7</picocli.version>
        <snakeyaml-engine.version>3.1.1</snakeyaml-engine.version>
        <anthropic-java.version>2.65.0</anthropic-java.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <!-- JavaFX 21, la version LTS qui tourne sur Java 21 ; AtlantaFX 2.0.1, la dernière qui n'exige pas plus. -->
        <javafx.version>21.0.12</javafx.version>
        <atlantafx.version>2.0.1</atlantafx.version>
        <!-- Rempli par JaCoCo ; vide par défaut pour que surefire démarre aussi sans lui. -->
        <argLine></argLine>
    </properties>

    <dependencies>
        <!-- Stockage : SQLite en JDBC nu, sans ORM (pile technique § 4). -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <!-- Lecture du profil YAML, avec la position de chaque valeur (UC-03). Dans stockage seulement. -->
        <dependency>
            <groupId>org.snakeyaml</groupId>
            <artifactId>snakeyaml-engine</artifactId>
            <version>${snakeyaml-engine.version}</version>
        </dependency>
        <!-- Modèle de langage : SDK officiel, dans le paquet ia seulement (pile technique § 6). -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic-java.version}</version>
        </dependency>
        <!-- Rendu des documents et relecture de leur texte, dans le paquet rendu seulement (pile technique § 6). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <!-- Interface de bureau (itération 9) : JavaFX, et un thème moderne. Le POM de JavaFX choisit
             lui-même les bibliothèques natives du système qui construit : ici, Windows. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
            <exclusions>
                <!-- il déclare JavaFX 20 ; c'est le 21 ci-dessus qui sert -->
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Le SDK journalise par SLF4J ; sans ce branchement « muet », chaque commande afficherait
             trois lignes d'avertissement. postulat a son propre journal, celui des appels en base. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.16</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Ligne de commande, dans le paquet cli seulement (pile technique § 5). -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>postulat</finalName>
        <plugins>
            <!-- Linter de la DoD : tous les avertissements du compilateur, traités comme des erreurs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- sqlite-jdbc charge une bibliothèque native : l'autoriser évite l'avertissement de Java 24+. -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <!-- Toujours reconstruire le jar simple : sinon un build sans « clean » reprend le jar déjà
                 fusionné du build précédent, et shade y retrouve chaque dépendance en double. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>

            <!-- Jar exécutable autonome : java -jar target/postulat.jar <commande> -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Le manifeste est réécrit en entier par le transformateur ci-dessous. -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- Liste informative des dépendances, propre à chaque jar de PDFBox. -->
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                    </excludes>
                                </filter>
                                <!-- okio et okio-jvm portent le même descripteur de module Kotlin. -->
                                <filter>
                                    <artifact>com.squareup.okio:okio</artifact>
                                    <excludes><exclude>META-INF/okio.kotlin_module</exclude></excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>postulat.cli.Postulat</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                        <Implementation-Title>postulat</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Licences et notices des dépendances Apache, réunies plutôt qu'écrasées. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Couverture de la DoD : >= 90 % sur le domaine seulement. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>preparer</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>rapport</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>seuil-domaine</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>postulat.suivi</include>
                                        <include>postulat.production</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Itération 9c : l'application Windows portable, avec son propre Java. mvnw -Ppaquet package
             écrit target/Postulat-VERSION-windows.zip ; voir src/paquet/Empaqueter.java. -->
        <profile>
            <id>paquet</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>empaqueter</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <!-- le Java qui fait tourner Maven : son jlink et son jpackage servent -->
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <!-- Maven lit ce que le programme écrit en UTF-8 : qu'il l'écrive ainsi -->
                                        <argument>-Dstdout.encoding=UTF-8</argument>
                                        <argument>-Dstderr.encoding=UTF-8</argument>
                                        <argument>src/paquet/Empaqueter.java</argument>
                                        <argument>${project.build.directory}</argument>
                                        <argument>${project.version}</argument>
                                        <classpath/>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
